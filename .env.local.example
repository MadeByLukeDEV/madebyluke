# .env.local — LOCAL DEVELOPMENT ONLY
# This file is gitignored and never deployed

# App
NEXT_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Database — points to the Docker 'db' service
DATABASE_URL="mysql://madebyluke:madebyluke@db:3306/madebyluke_dev"

# WebAuthn — MUST use localhost for local dev
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="madebyluke.dev (local)"
WEBAUTHN_ORIGIN=http://localhost:3000

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-here

# Resend — leave dummy for local (contact form won't send emails)
RESEND_API_KEY=re_dummy_local
RESEND_FROM=noreply@madebyluke.dev
CONTACT_TO_EMAIL=glukas250720@gmail.com
